# Copie para ~/.claude/narrador/.env e preencha (o plugin ja copia na
# primeira sessao depois da instalacao; falta so colar a chave).
# O plugin le, nesta ordem: variaveis do ambiente, ~/.claude/narrador/.env e
# um .env na raiz do plugin (util so em desenvolvimento).
# Cole a chave da ElevenLabs aqui, no formato sk_...
ELEVENLABS_API_KEY=

# Opcionais: sobrescrevem os padroes do speak.py
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Segundos de silencio apos cada ponto final na leitura em voz alta
# (0 desliga, maximo 3). A video-aula ignora: la a pausa e controle do player.
# ELEVENLABS_SENTENCE_PAUSE=2

# Idioma forcado (ISO 639-1). Sem isso o modelo adivinha pelo texto
# ELEVENLABS_LANGUAGE=pt

# Velocidade da fala: 1.0 e o normal, menor e mais lento.
# Fora de 0.7 a 1.2 o script recusa antes de chamar a API
# ELEVENLABS_SPEED=0.9

# Volume da reproducao, de 0 a 1 (1 e o audio como veio da ElevenLabs).
# Vale para a leitura em voz alta; na video-aula o volume e do player da pagina,
# e no replay e do programa de audio do sistema
# NARRADOR_VOLUME=0.5

# Quantas narracoes o historico guarda; o audio das que saem e apagado
# NARRADOR_HISTORICO_MAX=50

# Onde ficam chave, audio gerado e cache (padrao: ~/.claude/narrador)
# NARRADOR_HOME=
