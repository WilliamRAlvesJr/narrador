{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/speak_reply.py"
            ],
            "async": true,
            "timeout": 600,
            "statusMessage": "Narrando a resposta..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/semear_env.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
